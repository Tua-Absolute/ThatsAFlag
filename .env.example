# Required for the LLM AI check and web plagiarism search.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default claude-opus-5-5).
# claude-haiku-5-5 is far cheaper but less careful.
CLAUDE_MODEL=

# Strongly recommended once deployed: anyone with the site URL could otherwise
# spend your API credit. When set, the page asks for this password.
APP_PASSWORD=
